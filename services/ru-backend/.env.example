PORT=4000
JWT_SECRET=replace_with_long_random_secret
CORS_ORIGIN=*
PERSONAL_POSTGRES_HOST=127.0.0.1
PERSONAL_POSTGRES_PORT=5433
PERSONAL_POSTGRES_USER=analitika
PERSONAL_POSTGRES_PASSWORD=replace_with_database_password
PERSONAL_POSTGRES_DB=analitika_personal
PERSONAL_POSTGRES_SSL=false

# AI Quality Control stays disabled until the existing private MinIO and both
# Russian AI providers are configured. This service never creates the bucket.
QC_ENABLED=false
QC_WORKER_ENABLED=true
QC_POLL_INTERVAL_MS=2000
QC_MAX_ATTEMPTS=3
QC_RETRY_BASE_MS=5000
QC_JOB_LEASE_MS=900000
QC_MAX_UPLOAD_BYTES=52428800
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=replace_with_existing_minio_access_key
S3_SECRET_KEY=replace_with_existing_minio_secret_key
S3_BUCKET_AUDIO=ml-audio
S3_REGION=us-east-1
NEXARA_API_KEY=replace_with_nexara_key
NEXARA_BASE_URL=https://api.nexara.ru/v1
NEXARA_MODEL=whisper-1
NEXARA_TIMEOUT_MS=600000
GIGACHAT_AUTH_KEY=replace_with_gigachat_authorization_key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_TIMEOUT_MS=120000
# Optional PEM bundle when the runtime trust store lacks required Russian CAs.
GIGACHAT_CA_BUNDLE_PATH=
GIGACHAT_MAX_TRANSCRIPT_CHARS=100000
GIGACHAT_MAX_TOKENS=4096
QC_QUALITY_GOOD_THRESHOLD=80
QC_QUALITY_NEUTRAL_THRESHOLD=60
