{
  "cli": {
    "version": ">= 16.20.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_RU_API_URL": "https://affera.co.uk/ru",
        "EXPO_PUBLIC_DXB_API_URL": "https://affera.co.uk/dxb",
        "EXPO_PUBLIC_ML_API_URL": "https://affera.co.uk/ml"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_RU_API_URL": "https://affera.co.uk/ru",
        "EXPO_PUBLIC_DXB_API_URL": "https://affera.co.uk/dxb",
        "EXPO_PUBLIC_ML_API_URL": "https://affera.co.uk/ml"
      }
    }
  }
}
