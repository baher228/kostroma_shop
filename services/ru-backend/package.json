{
  "name": "ru-backend",
  "version": "1.0.0",
  "description": "Russia personal-data backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node init && ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "node init && tsc -p tsconfig.json",
    "start": "node init && node dist/server.js",
    "test": "npm run build && node --test tests/run-tests.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "ts-node src/db/migrate.ts"
  },
  "keywords": [
    "stock",
    "rbac",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1072.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "gigachat": "0.0.20",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "2.3.0",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "2.2.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2"
  }
}
