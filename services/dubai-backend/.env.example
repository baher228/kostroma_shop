PORT=4000
JWT_SECRET=replace_with_long_random_secret
CORS_ORIGIN=*
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=analitika
POSTGRES_PASSWORD=analitika_dev_password
POSTGRES_DB=analitika
POSTGRES_SSL=false

GOOGLE_DRIVE_POSTERS_FOLDER_ID=1ZWH5Em1VCkNfPSJp6KqFOYPW4L2PpcL9
# Choose one credential source. Base64 is the safest format for Docker Compose env_file.
# GOOGLE_APPLICATION_CREDENTIALS may be either a file path or a one-line JSON object.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_SIGNED_URL_TTL_SECONDS=900

# Gmail user OAuth is independent of the Google Drive service account above.
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=me
GMAIL_QUERY=has:attachment newer_than:30d
GMAIL_ALLOWED_SENDERS=
GMAIL_ALLOWED_EXTENSIONS=.pdf,.xlsx,.xls,.csv
GMAIL_POLL_INTERVAL_MS=60000
GMAIL_MAX_MESSAGES_PER_POLL=100
GMAIL_MAX_RETRIES=3
GMAIL_MAX_ATTACHMENT_BYTES=26214400
GMAIL_GLOBAL_DEDUPE_BY_HASH=false
# Local bootstrap only; not needed by production backend.
GMAIL_OAUTH_CREDENTIALS_FILE=secrets/gmail-oauth-client.json
