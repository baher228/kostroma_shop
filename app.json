{
  "expo": {
    "name": "Analitika Tablet",
    "slug": "kostroma",
    "owner": "hlpnes-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/531a62b9-9f92-4d40-9c41-57a6d155de00"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gringobochka.analitika",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#166534"
      },
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "name": "Analitika Tablet",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-updates",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Разрешите Analitika Tablet использовать камеру для сканирования FOB QR-кодов.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./withCleartextTraffic",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "531a62b9-9f92-4d40-9c41-57a6d155de00"
      }
    }
  }
}
